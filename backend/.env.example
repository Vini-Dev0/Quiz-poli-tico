NODE_ENV=development
PORT=3000
# Uma ou mais origens separadas por vírgula. Em produção, todas devem usar HTTPS.
APP_URL=http://localhost:3000,http://127.0.0.1:3000,https://ladopolitico.online
SEO_URL=https://ladopolitico.online
# Local e homologação: false. Na publicação em produção: true.
SEO_INDEXING_ENABLED=false
# Opcional: somente o token da metatag de verificação do Search Console.
GOOGLE_SITE_VERIFICATION=
DATABASE_URL=
ADMIN_PASSWORD=
JWT_SECRET=
ABANDONMENT_MINUTES=
TRUST_PROXY=
