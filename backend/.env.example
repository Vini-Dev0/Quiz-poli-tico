NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://quiz:replace-with-local-password@localhost:5432/quiz?schema=public
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ABANDONMENT_MINUTES=30
# 1 somente quando houver exatamente um proxy confiável na frente da aplicação.
TRUST_PROXY=0
