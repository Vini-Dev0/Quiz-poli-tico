{
  "name": "prisma-politica-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "node --test tests/scoring.test.js tests/validation.test.js tests/config.test.js tests/result-view.test.js tests/app-url.test.js tests/seo.test.js tests/i18n.test.js",
    "assets:build": "node scripts/build-social-assets.js",
    "seo:check": "node scripts/seo-check.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.js",
    "test:e2e": "playwright test",
    "test:docker": "node tests/deployment-smoke.js",
    "test:i18n": "node --test tests/i18n.test.js",
    "lint": "node scripts/lint.js",
    "typecheck": "tsc -p tsconfig.i18n.json",
    "build": "prisma generate && npm run lint && npm run typecheck && npm run test:i18n"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "supertest": "7.2.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
