generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuizStatus {
  STARTED
  COMPLETED
  ABANDONED
}

model QuizSession {
  id              Int        @id @default(autoincrement())
  uuid            String     @unique @default(uuid()) @db.Uuid
  editTokenHash   String
  quizVersion     String     @default("v1")
  status          QuizStatus @default(STARTED)
  currentQuestion Int        @default(1)
  answers         Json       @default("{}")
  economicScore   Float?
  authorityScore  Float?
  economicLabel   String?
  authorityLabel  String?
  politicalLabel  String?
  startedAt       DateTime   @default(now())
  lastActivityAt  DateTime   @default(now())
  completedAt     DateTime?
  shared          Boolean    @default(false)
  sharedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, lastActivityAt])
  @@index([startedAt, id])
  @@index([status, economicScore])
  @@index([status, authorityScore])
  @@index([shared])
}

// Sessões administrativas revogáveis. Nunca armazenamos o JWT ou a senha.
model AdminSession {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
