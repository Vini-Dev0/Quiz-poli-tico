# Cole na aba Environment do serviço App e substitua os valores de exemplo.
# Deixe a opção Create env file desativada; a aplicação usa process.env.
NODE_ENV=production
PORT=3000
APP_URL=https://ladopolitico.online
# Para dois domínios, acrescente a segunda origem HTTPS na mesma linha, separada por vírgula.
SEO_URL=https://ladopolitico.online
SEO_INDEXING_ENABLED=true
# Opcional: cole somente o token da metatag do Search Console, sem o HTML.
GOOGLE_SITE_VERIFICATION=
DATABASE_URL=replace-with-the-internal-postgres-url-from-easypanel
ADMIN_PASSWORD=replace-with-a-random-admin-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ABANDONMENT_MINUTES=30
TRUST_PROXY=1
